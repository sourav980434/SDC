*
!private/
!public/
!.gitignore

# Word report templates are shared through git (Report Template master / report editor)
!REPORT_MASTER/
!REPORT_MASTER/**
# ...but local backups and per-PC default choices stay on this PC
REPORT_MASTER/_versions/
REPORT_MASTER/_deleted/
REPORT_MASTER/_defaults.json
# temp folders from a crashed conversion
REPORT_MASTER/_html/work_*/

# Generated patient report PDFs - tracked during the development phase
!reports/
!reports/**
