adding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>Reference Range :- \u00a0Adults&lt; 200 IU\/ml<\/span><\/b><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0Children upto 5 years &lt;100 IU\/ml<\/span><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=569 colspan=6 valign=top style='width:427.1pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=569 colspan=6 valign=top style='width:427.1pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=569 colspan=6 valign=top style='width:427.1pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=85 valign=top style='width:63.75pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>MFD BY<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=35 colspan=2 valign=top style='width:26.25pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>:-<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=449 colspan=3 valign=top style='width:337.1pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>TRANSASIA\r\n  BIO-MEDICAL LTD <\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=85 valign=top style='width:63.75pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>Kit Used<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=35 colspan=2 valign=top style='width:26.25pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>:-<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=449 colspan=3 valign=top style='width:337.1pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>ERBA\r\n  XL SYSTEM PACKS<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=85 valign=top style='width:63.75pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>Lot no.<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=35 colspan=2 valign=top style='width:26.25pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>:-<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=449 colspan=3 valign=top style='width:337.1pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>S012368<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr height=0>\r\n  <td width=85 style='border:none'><\/td>\r\n  <td width=24 style='border:none'><\/td>\r\n  <td width=10 style='border:none'><\/td>\r\n  <td width=46 style='border:none'><\/td>\r\n  <td width=67 style='border:none'><\/td>\r\n  <td width=321 style='border:none'><\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<\/div>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>NOTE:<\/span><\/b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\r\nImmunological testing for specific antibodies to streptococcal metabolites provides\r\nimportant information regarding a prior streptococcal infection. Antibodies are\r\nformed against both the pathogen itself and its metabolic products. An example\r\nfor the latter is the antibody against streptolysin O, an enzyme secreted by\r\nbetahaemolytic streptococci of the Landfield Group A. Antistreptolysin O (ASO)\r\ntesting is thus used for the diagnosis of non suprative complications if the\r\ninfections caused by this pathogens: acute rheumatic fever or acute\r\npoststreptococcal glomerulonephritis. In the determination of antibodies to various\r\nstreptococcal exoenzymes preference is to be given to anti-streptolysin O,\r\nsince this sensitive parameters is found to be elevated in about 80 to 85% of\r\ncases.\u00a0\u00a0\u00a0 \u00a0\u00a0\u00a0\u00a0\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n\"Bookman Old Style\",serif'>*VALUES RECHECKED<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n\"Bookman Old Style\",serif'>DRAWN SAMPLE FROM OUTSIDE<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Test Done By: \u2013 Fully Automated Clinical Chemistry\r\nAnalyzer. (EM 200)<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"595.45pt 841.7pt","margin":"151.2pt 36.0pt 72.0pt 36.0pt"}}