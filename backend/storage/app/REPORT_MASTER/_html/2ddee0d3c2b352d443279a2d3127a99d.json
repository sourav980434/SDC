;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.75pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.5pt'>\r\n  <td width=609 colspan=4 valign=top style='width:456.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.5pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:8.55pt'>\r\n  <td width=114 valign=top style='width:85.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:8.55pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>KIT USED<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=29 valign=top style='width:21.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:8.55pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>:-<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=466 colspan=2 valign=top style='width:349.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:8.55pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>HEPACARD<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:10.35pt'>\r\n  <td width=114 valign=top style='width:85.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:10.35pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>MFG BY.<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=29 valign=top style='width:21.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:10.35pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>:-<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=466 colspan=2 valign=top style='width:349.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:10.35pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>Diagnostic\r\n  Enterprises<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.75pt'>\r\n  <td width=114 valign=top style='width:85.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.75pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>LOT NO<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=29 valign=top style='width:21.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.75pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>:-<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=466 colspan=2 valign=top style='width:349.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.75pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>HPC112248<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<\/div>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US\r\nstyle='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>NOTE:<\/span><\/b><span\r\nlang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'> <\/span><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Hepatitis\r\nB virus (HBV) is the most common causes of persistent viremia and the most\r\nimportant cause of chronic liver disease and hepatocellular carcinoma.\r\nClinically apparent HBV infections may have been extent for several millennia.\r\nIt is estimated that there are 300 million chronic carriers of HBV in the\r\nworld. The carrier rates vary from as little as 0.3% (western countries) to 20%\r\n(Asia, Africa). HBV is a hepatotropic DNA virus. The core of the virus contains\r\na DNA polymerase, the core antigen (HBcAg) and the \u201c e \u201d antigen (HBeAg). The\r\ncore of HBV is enclosed in a coat that contains lipid, proteins and\r\ncarbohydrate and expresses and antigen terms Hepatitis B surface antigen\r\n(HBsAg). <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>HBsAg is the\r\nfirst marker to appear in the blood in acute hepatitis B, being detected 1 week\r\nto 2 months after exposure and 2 weeks to 2 months before the onset of\r\nsymptoms. Three weeks after the onset of acute hepatitis almost half of the\r\npatients will still be positive for HBsAg. In the chronic carrier state, the\r\nHBsAg\u00a0 persists for long periods (6-12 months) with no sero-conversion to the\r\ncorresponding antibodies. Therefore, screening for HBsAg is highly desirable\r\nfor all donors, pregnant women and people in high risk groups.\u00a0\u00a0\u00a0 <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n\"Bookman Old Style\",serif'>DRAWN SAMPLE FROM OUTSIDE<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Remarks: It is a screening test.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Suggested confirmation by ELISA\/CLIA assay.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"595.45pt 841.7pt","margin":"151.2pt 36.0pt 72.0pt 36.0pt"}}