r>\r\n <tr style='height:13.4pt'>\r\n  <td width=256 valign=top style='width:192.15pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=132 valign=top style='width:99.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=94 valign=top style='width:70.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.95pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:119.15pt'>\r\n  <td width=256 valign=top style='width:192.15pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:119.15pt'>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\n  style='font-size:11.0pt'>ANTI\u00a0 SCL \u2013 70 ANTIBODY<\/span><\/b><\/p>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US>Reference Range :<\/span><\/b><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US>Negative\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 : &lt; 0.90<\/span><\/b><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US>Equivocal\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 : 0.90\u2013 1.10<\/span><\/b><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US>\u00a0Positive\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 &gt; 1.10\u00a0 : <\/span><\/b><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=132 valign=top style='width:99.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:119.15pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:12.0pt'>E.L.I.S.A<\/span><\/p>\r\n  <\/td>\r\n  <td width=94 valign=top style='width:70.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:119.15pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt'>0.52<\/span><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.95pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:119.15pt'>\r\n  <p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n  style='font-size:11.0pt'>OD Ratio<\/span><\/p>\r\n  <p class=MsoNormal style='margin-left:.6pt'><span lang=EN-US\r\n  style='font-size:12.0pt'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>Clinical\r\nSignificance:<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>This\r\nassay is used as an aid in diagnosis of autoimmune disease by detection of\r\nantibodies against Scl-70 antigen in serum.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>System\r\nsclerosis (scleroderma) is a chronic disease of unknown etiology which affects\r\nconnective tissue and small arteries. It is characterized by fibrotic and\r\ndegenerative changes in the skin, blood vessels and internal organs. 20-33% of\r\nscleroderma cases shows elevated Sca-70 antibodies in their serum. Apart from\r\nscleroderma, it is found to be elevated in a few other connective tissue\r\ndisorders as well.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Please correlate with clinical conditions<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"148.85pt 