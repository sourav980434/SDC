pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><u><span\r\n  lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>Result<\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n  <td width=75 valign=top style='width:56.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><u><span\r\n  lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>Unit<\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n  <td width=270 valign=top style='width:202.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><b><u><span lang=EN-US style='font-size:12.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>Biological Reference Range<\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.4pt'>\r\n  <td width=336 valign=top style='width:252.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><b><u><span lang=EN-US style='font-size:12.0pt'><span\r\n   style='text-decoration:none'>&nbsp;<\/span><\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=75 valign=top style='width:56.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:12.0pt'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=270 valign=top style='width:202.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:12.0pt'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.4pt'>\r\n  <td width=336 valign=top style='width:252.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>THYROGLOBULIN <\/span><\/b><\/p>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>(CLIA)<\/span><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>1.21<\/span><\/p>\r\n  <\/td>\r\n  <td width=75 valign=top style='width:56.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>ng\/mL<\/span><\/p>\r\n  <\/td>\r\n  <td width=270 valign=top style='width:202.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>1.59\r\n  - 50.03<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.4pt'>\r\n  <td width=336 valign=top style='width:252.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=75 valign=top style='width:56.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=270 valign=top style='width:202.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.5pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>COMMENT\r\n:<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>1.\r\nPrimarily used as a tumor marker in patients with a diagnosis of Differentiated\r\nThyroid carcinoma ( <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\r\nDTC). Tg levels are elevated in both Thyroid, Papillary &amp; Follicular\r\ncarcinoma <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>2.\r\nSerial measurements of Tg are most useful in detecting recurrence of DTC\r\nfollowing surgical resection \u00a0\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\r\nor radioactive Iodine ablation <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>3.\r\nAids in the management of infants with Congenital Hypothyroidism <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>4.\r\nDifferential diagnosis of Hyperthyroidism. Tg is elevated in all patients with\r\nHyperthyroidism except in \u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\r\ncases of Thyrotoxicosis factitia<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Increased Levels<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>1. Thyroid Papillary &amp; Follicular\r\ncarcinoma <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>2. \u00a0Non neoplastic thyroid conditions like\r\nThyroid adenoma, Subacute thyroiditis, Hashimoto\u2019s thyroiditis &amp; Graves\u2019\r\ndisease<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>\u00a03. Regions of Endemic goitre<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>\u00a04. Neonates<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>\u00a05. Third trimester of pregnancy<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Note:<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>1. This test is not recommended for the\r\ndiagnosis of Thyroid cancer <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>2. Presence of Thyroglobulin autoantibodies\r\ncan interfere in the assay leading to an under estimation of Thyroglobulin\r\nlevels. <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>\u00a0\u00a0\u00a0 Therefore the Thyroglobulin antibody\r\nstatus should be determined when measuring Tg<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>\u00a03. Minimum 6 weeks should elapse post\r\nthyroidectomy or thyroid gland ablation prior to testing <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>4. Thyroglobulin levels may remain elevated\r\nfor several months following successful cancer therapy. In these cases post <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>\u00a0\u00a0\u00a0\u00a0 treatment baseline values followed by\r\nserial determinations are recommended for monitoring<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"153.0pt 49.5pt 72.0pt 49.5pt"}}