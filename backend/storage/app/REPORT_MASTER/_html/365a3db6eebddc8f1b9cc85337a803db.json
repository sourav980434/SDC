dth:107.4pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><b><u><span lang=EN-US\r\n  style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>Observed\r\n  Value<\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n  <td width=60 valign=top style='width:45.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><b><u><span lang=EN-US\r\n  style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>UNIT<\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n  <td width=343 valign=top style='width:257.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><b><u><span lang=EN-US\r\n  style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>BIOLOGICAL\r\n  REFERENCE INTERVAL<\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=201 valign=top style='width:150.6pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><span lang=EN-US\r\n  style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=143 valign=top style='width:107.4pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><span lang=EN-US\r\n  style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=60 valign=top style='width:45.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><span lang=EN-US\r\n  style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=343 valign=top style='width:257.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><span lang=EN-US\r\n  style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=201 valign=top style='width:150.6pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><b><span lang=EN-US\r\n  style='font-family:\"Bookman Old Style\",serif'>IL-6 (Interleukin -6)*<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=143 valign=top style='width:107.4pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center;line-height:115%'><span\r\n  lang=EN-US style='font-family:\"Bookman Old Style\",serif'>1.77<\/span><\/p>\r\n  <\/td>\r\n  <td width=60 valign=top style='width:45.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center;line-height:115%'><span\r\n  lang=EN-US style='font-family:\"Bookman Old Style\",serif'>pg\/mL<\/span><\/p>\r\n  <\/td>\r\n  <td width=343 valign=top style='width:257.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='margin-left:.6pt;line-height:115%'><span\r\n  lang=EN-US style='font-family:\"Bookman Old Style\",serif'>0.00-7.00<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=201 valign=top style='width:150.6pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='line-height:115%'><span lang=EN-US\r\n  style='font-size:8.0pt;line-height:115%;font-family:\"Arial\",sans-serif'>(EDTA\r\n  PLASMA,ECLIA)<\/span><\/p>\r\n  <\/td>\r\n  <td width=143 valign=top style='width:107.4pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center;line-height:115%'><span\r\n  lang=EN-US style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=60 valign=top style='width:45.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal align=center style='text-align:center;line-height:115%'><span\r\n  lang=EN-US style='font-size:12.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=343 valign=top style='width:257.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='margin-left:.6pt;line-height:115%'><span\r\n  lang=EN-US style='font-size:11.0pt;line-height:115%;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Interpretation :-<\/span><\/b><\/p>\r\n\r\n<ol style='margin-top:0cm' start=1 type=1>\r\n <li class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n     style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Interleukin-6(IL-6)\r\n     is a pleiotropic cytokine with a wide range of functions.<\/span><\/li>\r\n <li class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n     style='font-family:\"Arial\",sans-serif'>\u00a0<\/span><span lang=EN-US\r\n     style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>IL-6 production is\r\n     rapidly induced in the course of acute inflammatory reactions associated\r\n     with injury trauma,stress,<\/span><\/li>\r\n<\/ol>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\ninfection, brain death, neoplasia ,and other situations.<\/span><\/p>\r\n\r\n<ol style='margin-top:0cm' start=3 type=1>\r\n <li class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n     style='font-family:\"Arial\",sans-serif'>\u00a0<\/span><span lang=EN-US\r\n     style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>IL-6 concentrations\r\n     in trauma patients may predict later complications from additional\r\n     surgical stress or indicate missed<\/span><\/li>\r\n<\/ol>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 injuries\r\nor complications.<\/span><\/p>\r\n\r\n<ol style='margin-top:0cm' start=4 type=1>\r\n <li class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n     style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Sequential\r\n     measurements of IL-6 in serum or plasma of patients admitted to the ICU\r\n     showed to be useful in evaluating\u00a0\u00a0 <\/span><\/li>\r\n<\/ol>\r\n\r\n<p class=MsoNormal style='margin-left:36.0pt;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>The severity\r\nof SIRS ( Systemic inflammatory response syndrome) ,sepsis and septic shock and\r\nto predict the outcome of\u00a0\u00a0 <\/span><\/p>\r\n\r\n<p class=MsoNormal style='margin-left:36.0pt;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0these\r\npatients .<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 5.\u00a0\u00a0\u00a0 <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>IL-6 is also useful as\r\nan early alarm marker for the detection of neonatal sepsis.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 6.\u00a0\u00a0\u00a0 <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>IL-6 also plays a role\r\nin chronic inflammation eg. Rheumatoid arthritis(RA)<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>NOTE: <\/span><\/b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Sample\r\ncollected in red top plain tube non-sst can give excessively high result.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 (\r\nREFERENCE-Pre-analytical effects of blood sampling and handling in quantitative\r\nimmunoassays for rheumatoid arthritis\u00a0\u00a0 <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 By\r\nCrescendo Bioscience, Inc.,341 Oyster Point Blvd., South San Francisco, CA\r\n94080, United States )<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0Patients on\r\nBiotin supplement may have interference in some immunoassays. With individuals\r\ntaking high dose Biotin \u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 (more than\r\n5<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 mg per day)\r\nsupplements, at least 8-hour wait time before blood draw is recommended.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"153.0pt 45.0pt 72.0pt 45.0pt"}}