.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.2pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=229 valign=top style='width:171.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.2pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.45pt'>\r\n  <td width=307 valign=top style='width:230.4pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>LITHIUM (LI)<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=102 valign=top style='width:76.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:10.5pt'>0.57<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>mmol\/L<\/span><\/p>\r\n  <\/td>\r\n  <td width=229 valign=top style='width:171.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>0.60\r\n  - 1.50<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:16.2pt'>\r\n  <td width=307 valign=top style='width:230.4pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>(Methodology:\r\n  ISE)<\/span><\/p>\r\n  <\/td>\r\n  <td width=102 valign=top style='width:76.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=229 valign=top style='width:171.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'><\/td>\r\n <\/tr>\r\n <tr style='height:13.45pt'>\r\n  <td width=307 valign=top style='width:230.4pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Therapeutic\r\n  range 0.60 -1.20 mEq\/L (m mole\/L)<\/span><\/p>\r\n  <\/td>\r\n  <td width=102 valign=top style='width:76.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=229 valign=top style='width:171.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'><\/td>\r\n <\/tr>\r\n <tr style='height:13.45pt'>\r\n  <td width=307 valign=top style='width:230.4pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Toxic\r\n  level &gt;1.50 mEq\/L (m mole\/L)<\/span><\/p>\r\n  <\/td>\r\n  <td width=102 valign=top style='width:76.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=229 valign=top style='width:171.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.45pt'><\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>COMMENT<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>The lithium test is used to\r\nmeasure and monitor the amount of lithium in the blood so that a healthcare\r\npractitioner can determine whether the drug blood concentration is within the\r\nrange that will adequately treat an individual's bipolar disorder (therapeutic\r\nrange). The test may be used to measure blood levels every few days when a\r\nperson first begins taking lithium to help adjust the dose and reach the\r\ndesired blood level and may also be used at regular intervals or as needed to\r\nmonitor blood concentrations. If<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>a person starts taking additional\r\nmedications, a healthcare practitioner may order one or more lithium tests to\r\njudge their effect, if any, on lithium levels. Lithium tests may also be ordered\r\nif toxicity is suspected. Lithium is available commercially as citrate and\r\ncarbonate salts. Lithium salts are considered to be anti-manic agents and are\r\nused for the prophylaxis and treatment of bipolar disorder ( Manic depressive\r\npsychosis). In addition, lithium is considered by some investigators to be the\r\ndrug of choice for prevention of chronic cluster headache and may also be\r\neffective in episodic or periodic forms of cluster headache. Complete\r\nabsorption of lithium occurs after6-8 hrs of oral administration. Plasma half\r\nlife varies from 17-36 hrs and onset of action is slow ( 5-10 days). Since\r\nlithium shows delayed and varied tissue distribution, symptoms of acute\r\nintoxication may not correlate well with serum levels. Toxicity may occur\r\nacutely as a result of single toxic dose or chronically from high \/ prolonged\r\ndosages of lithium. Fever, diarrhea, vomiting, diuretics and pyelonephritis are\r\ncontributing factors in underlying<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>chronic intoxication. Renal\r\ntoxicity and hypothyroidism are also known side effects of lithium\r\nadministration. Thus it is advisable to monitor creatinine and TSH levels periodically\r\nin patients on lithium.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<