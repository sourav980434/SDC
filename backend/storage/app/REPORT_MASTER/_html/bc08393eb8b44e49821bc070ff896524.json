4.45pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:12.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:14.45pt'>\r\n  <td width=221 valign=top style='width:165.65pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.45pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=108 valign=top style='width:80.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=74 valign=top style='width:55.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.45pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=347 valign=top style='width:260.6pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.45pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:128.6pt'>\r\n  <td width=221 valign=top style='width:165.65pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:128.6pt'>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>VITAMIN\r\n  D,25-HYDROXY<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\n  style='font-size:8.0pt'>(enzyme \u2013linked immunosorbent assay)<\/span><\/b><\/p>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>\u00a0<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=108 valign=top style='width:80.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:128.6pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>00.0<\/span><\/p>\r\n  <\/td>\r\n  <td width=74 valign=top style='width:55.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:128.6pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>ng\/ml<\/span><\/p>\r\n  <\/td>\r\n  <td width=347 valign=top style='width:260.6pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:128.6pt'>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Very\r\n  Severe Vitamin D Deficiency\u00a0\u00a0 : &lt; 5 <\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Severe\r\n  Vitamin D Deficiency : 5-10<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Vitamin D\r\n  Deficiency\u00a0\u00a0\u00a0 : 10-20<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Suboptimal\r\n  Vitamin D provision : 20-30<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Optimal\r\n  Vitamin D Level : 30-50<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Upper norm\r\n  : 50-70<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Overdose,\r\n  but not Toxic : 70-150<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US>Vitamin D\r\n  Intoxication : &gt; 150<\/span><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Clinical correlation is suggested. <\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>DRAWN\r\nSAMPLE FROM OUTSIDE<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Lisa Scan-EM (Semi-Automated Clinical Chemistry\r\nAnalyzer)<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;