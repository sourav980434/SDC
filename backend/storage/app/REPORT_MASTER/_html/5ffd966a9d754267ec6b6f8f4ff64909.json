e='height:12.65pt'>\r\n  <td width=303 valign=top style='width:227.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>INVESTIGATION<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=93 valign=top style='width:69.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>OBSERVED\r\n  VALUE<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=59 valign=top style='width:44.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>UNIT<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=254 valign=top style='width:190.65pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>BIOLOGICAL\r\n  REFERENCE INTERVAL<\/span><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.65pt'>\r\n  <td width=303 valign=top style='width:227.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'><\/td>\r\n  <td width=93 valign=top style='width:69.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'><\/td>\r\n  <td width=59 valign=top style='width:44.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'><\/td>\r\n  <td width=254 valign=top style='width:190.65pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.65pt'><\/td>\r\n <\/tr>\r\n <tr style='height:25.95pt'>\r\n  <td width=303 valign=top style='width:227.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:25.95pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:10.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>CEA-Carcino Embryonic Antigen,Serum*<\/span><\/b><\/p>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:10.0pt;font-family:\"Bookman Old Style\",serif'>(Serum,CMIA)<\/span><\/p>\r\n  <\/td>\r\n  <td width=93 valign=top style='width:69.85pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:25.95pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-family:\"Arial\",sans-serif'>1.01<\/span><\/p>\r\n  <\/td>\r\n  <td width=59 valign=top style='width:44.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:25.95pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-family:\"Arial\",sans-serif'>ng\/mL<\/span><\/p>\r\n  <\/td>\r\n  <td width=254 valign=top style='width:190.65pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:25.95pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-family:\"Arial\",sans-serif'>Non-Smoking: 0-2.5<\/span><\/p>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-family:\"Arial\",sans-serif'>Smoking: 0-5<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Interpretation :<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>1. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>CEA (Carcinoembryonic\r\nAntigen), is an oncofetal glycoprotein and is expressed in normal mucosal cells\r\nand over expressed<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>in adenocarcinoma,\r\nespecially colorectal cancer.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>2. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>CEA is used as a marker\r\nfor monitoring colorectal and gastrointestinal carcinoma and is raised in\r\ncarcinoma of lung<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>,breast,liver,pancreas\r\n,prostate ,stomach and ovary .<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>3. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Benign conditions which\r\ncan elevate CEA include smoking, hepatic diseases, infections, inflammatory\r\nbowel disease,<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>trauma, collagen\r\nvascular disease, renal disorders, pancreatitis, cirrhosis of the liver and\r\npeptic ulcer, hypothyroidism,<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>chemotheraphy and\r\nradiation. Although values are usually less than 10 ng\/mL.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>4. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>CEA is not an effective\r\nscreening test for hidden (occult cancer since early tumors do not cause\r\nsignificant blood elevations .<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>5. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>A single test result is\r\ndifficult to evaluate, but a number of tests, done weeks apart, shows trends in\r\ndisease progression or regression .<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><sp