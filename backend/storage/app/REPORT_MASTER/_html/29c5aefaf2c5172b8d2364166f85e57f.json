.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=220 valign=top style='width:164.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Reference\r\nRange:-<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Negative\u00a0\u00a0\r\n: &lt; 12\u00a0\u00a0 U\/ml<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Equivocal\u00a0\r\n: 12- 18 U\/ml <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Positive\u00a0\u00a0\u00a0\u00a0\r\n: &gt; 18\u00a0\u00a0\u00a0 U\/ml<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Clinical\r\nSignificance:<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>It is an\r\nImmunoassay employing highly purified native proteinase 3 (PR3) from human neutrophil\r\ngranulocytes for the qualitative detection of antibodies against PR3 in human\r\nserum. Ancas are important markers for the differential diagnosis of Autoimmune\r\nVasculitis. Autoantibodies to proteinase 3 are specific serological marker for\r\nWegeners Granulomatosis (WG). A definite clinical diagnosis should not be based\r\non the results of single test, But should be made by the Physicians after all\r\nclinical and laboratory finds have been evaluated.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Please correlate\r\nwith clinical conditions.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>