 0cm 5.4pt;\r\n  height:14.15pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=247 valign=top style='width:185.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.15pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:15.0pt'>\r\n  <td width=366 valign=top style='width:274.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:15.0pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>HEPATITIS C ANTIBODY (Anti HCV) : ELISA<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=78 valign=top style='width:58.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:15.0pt'><\/td>\r\n  <td width=72 valign=top style='width:54.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:15.0pt'><\/td>\r\n  <td width=247 valign=top style='width:185.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:15.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&lt;1\u00a0\r\n  NEGATIVE<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:14.15pt'>\r\n  <td width=366 valign=top style='width:274.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.15pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Methodology\r\n  : ELISA<\/span><\/p>\r\n  <\/td>\r\n  <td width=78 valign=top style='width:58.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.15pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=72 valign=top style='width:54.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.15pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=247 valign=top style='width:185.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.15pt'><\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US>\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>COMMENTS <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>Hepatitis (HCV) is an RNA virus of\r\nFlavivirus group transmitted via blood transfusions, transplantation, injection\r\ndrug users, accidental needle punctures, dialysis patients and rarely from\r\nmother to infant (vertical transmission). 10% of new cases show sexual\r\ntransmission.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>NOTE <\/span><\/p>\r\n\r\n<ol style='margin-top:0cm' start=1 type=1>\r\n <li class=MsoNormal><span lang=EN-US>False positive results are seen in\r\n     autoimmune disease, Hypergammaglobulinemia, Paraproteinemia, Rheumatoid\r\n     factor, passive antibody transfer etc.<\/span><\/li>\r\n <li class=MsoNormal><span lang=EN-US>False negative results are seen in early\r\n     acute infection, Immunosuppression &amp; immune \u2013 icompetence.<\/span><\/li>\r\n <li class=MsoNormal><span lang=EN-US>The centers for disease control and\r\n     Prevention (CDC) recommends that all positive antibody tests be followed\r\n     by an HCV RNA test that detects viral RNA in the blood to determine\r\n     whether or not the person has an active infection. <\/span><\/li>\r\n<\/ol>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"148.5pt 36.0pt 72.0pt 31.5pt"}}