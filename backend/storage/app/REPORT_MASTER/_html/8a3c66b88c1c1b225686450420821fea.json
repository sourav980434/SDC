{"scope":"rt-463dd73bae","css":".rt-463dd73bae p.MsoNormal, .rt-463dd73bae li.MsoNormal, .rt-463dd73bae div.MsoNormal {margin:0cm; font-size:10.0pt; font-family:\"Times New Roman\",serif;}\n.rt-463dd73bae h3 {margin-top:0cm; margin-right:0cm; margin-bottom:0cm; margin-left:.6pt; text-align:center; page-break-after:avoid; font-size:12.0pt; font-family:\"Bookman Old Style\",serif; text-decoration:underline;}\n.rt-463dd73bae h4 {margin:0cm; text-align:center; page-break-after:avoid; font-size:12.0pt; font-family:\"Bookman Old Style\",serif; text-decoration:underline;}\n.rt-463dd73bae div.WordSection1 {}","html":"<div class=WordSection1>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='position:relative;\r\nz-index:251658240;left:-66px;top:8px;width:1043px;height:10px'><img width=834\r\nheight=2 src=\"data:image\/gif;base64,R0lGODlhEwQCAHcAMSH+GlNvZnR3YXJlOiBNaWNyb3NvZnQgT2ZmaWNlACH5BAEAAAAALAAAAAATBAIAgAAAAAAAAAJHBHKJq83vIpyy0msz3rrz74XgKJbkaaboqrbs68bwLNf0bef4rvf87wsCh8KSgYgsJpfKJvPpjEKn0ir1as1it9ou9+vNFgAAOw==\"><\/span><span lang=EN-US><b>&nbsp;<\/b><\/span><\/p>\r\n\r\n<br clear=ALL>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><u><span\r\nlang=EN-US style='font-size:14.0pt;font-family:\"Bookman Old Style\",serif'>DEPARTMENT\r\nOF PATHOLOGY<\/span><\/u><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><u><span\r\nlang=EN-US style='font-size:5.0pt;font-family:\"Bookman Old Style\",serif'><span\r\n style='text-decoration:none'>&nbsp;<\/span><\/span><\/u><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><u><span\r\nlang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>THYROID\r\nPROFILE FREE: FT3, FT4 &amp; TSH (FTFT)<\/span><\/u><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family: