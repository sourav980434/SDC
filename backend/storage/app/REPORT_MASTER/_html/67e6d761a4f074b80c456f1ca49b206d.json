m 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>THYROID STIMULATING HORMONE(TSH)<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=80 valign=top style='width:60.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u00b5IU\/mL<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>0.39\r\n  - 6.16 <\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.0pt'>\r\n  <td width=343 valign=top style='width:257.1pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:8.0pt'>(enzyme \u2013linked\r\n  immunosorbent assay )<\/span><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=80 valign=top style='width:60.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.0pt'>\r\n  <td width=343 valign=top style='width:257.1pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=80 valign=top style='width:60.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.75pt'>\r\n  <td width=343 valign=top style='width:257.1pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=80 valign=top style='width:60.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<\/div>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:8.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><u><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>T4:<\/span><\/u><\/b><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0 <\/span><\/b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Thyroxine\r\nhormone is secreted in the thyroid gland which is the most important component\r\nof the endocrine system. Over 99% thyroxine secreted in the blood is bound to\r\nThyroxine Binding Globulin (TBG), albumin and pre-albumin. The total Thyroxine\r\n(T4) content in blood is important in detecting thyroid disorders. In\r\nhyperthyroidism, like in those with Grave\u2019s disease, the T4 level is increased\r\nin blood, while in hypothyroidism, like in those with myxedema, the T4 level is\r\ndecreased. <b>\u00a0<\/b>\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><u><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>TSH:<\/span><\/u><\/b><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'> <\/span><\/b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>The\r\nThyroid Stimulating Hormone (thyrotropin or TSH) is a glycoprotein with a\r\nmolecular weight of 28000, secreted by the adenohypophysis. TSH is controlled\r\nby negative feedback from circulating T3, T4 and TRH (Thyrotropin Releasing\r\nHormone).<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>The measurement\r\nof serum TSH has proven to be one of the most sensitive methods for the\r\ndetection of primary hypothyroidism. In primary hypothyroidism the production\r\nof thyroid hormones is impaired and the TSH levels are observed to be higher.\r\nHowever, is secondary and tertiary hypothyroidism, the TSH levels are low\r\nbecause of pituitary of hypothalamic lesions.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>In hypothyroidism\r\nthe circulating level of TSH is usually subnormal. In some instances, however\r\nthis condition may result from hyperstimulation of the thyroid, due to\r\nhypothalamic or pituitary lesions and in this case the TSH level is increased. <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Clinical correlation is suggested. <\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Lisa Scan-EM (Semi-Automated Clinical ELISA\r\nAnalyzer)<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>OUT SIDE SAMPLE<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"595.45pt 841.7pt","margin":"151.2pt 36.0pt 72.0pt 36.0pt"}}