ht:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=123 valign=top style='width:92.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=220 valign=top style='width:164.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.7pt'>\r\n  <td width=310 valign=top style='width:232.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=96 valign=top style='width:71.7pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=123 valign=top style='width:92.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=220 valign=top style='width:164.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Reference\r\nRange:-<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Negative :&lt;\r\n0.90<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Equivocal: -\r\n0.90-1.10<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Positive:\r\n&gt;1.10<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Clinical\r\nSignificance:<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>This assay is\r\nused as an aid in diagnosis of autoimmune disease by detection of antibodies\r\nagainst Scl-70 antigen in serum.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Systemic\r\nsclerosis (scleroderma) is a chronic disease of unknown etiology which affects\r\nconnective tissue and small arteries. It is characterized by fibrotic and\r\ndegenerative changes in the skim, blood vessels and internal organs. 20-33% of\r\nscleroderma cases shows elevated Scl-70 antibodies in their serum. Apart from\r\nscleroderma, it is found to be elevated in a few other connective tissue\r\ndisorders as well,\u00a0\u00a0 \u00a0\u00a0\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Please correlate\r\nwith clinical conditions.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"148.85pt 90.0pt 72.0pt 42.55pt"}}