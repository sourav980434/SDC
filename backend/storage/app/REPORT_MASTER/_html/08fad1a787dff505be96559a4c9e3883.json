an lang=EN-US style='font-size:11.0pt'><span\r\n   style='text-decoration:none'>&nbsp;<\/span><\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><b><u><span lang=EN-US style='font-size:11.0pt'><span\r\n   style='text-decoration:none'>&nbsp;<\/span><\/span><\/u><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:14.85pt'>\r\n  <td width=313 valign=top style='width:234.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-family:\"Arial\",sans-serif'>tTG\r\n  (Tissue Transglutaminase) IgA<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=151 valign=top style='width:4.0cm;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-family:\"Arial\",sans-serif'>Negative\r\n  (2.08)<\/span><\/p>\r\n  <\/td>\r\n  <td width=81 valign=top style='width:60.95pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>AU\/mL<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n  style='font-family:\"Arial\",sans-serif'>Negative: &lt; 8<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.7pt'>\r\n  <td width=313 valign=top style='width:234.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>(Serum,\r\n  CLIA)<\/span><\/p>\r\n  <\/td>\r\n  <td width=151 valign=top style='width:4.0cm;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'><\/td>\r\n  <td width=81 valign=top style='width:60.95pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'><\/td>\r\n  <td width=222 valign=top style='width:166.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n  style='font-family:\"Arial\",sans-serif'>Positive: &gt;= 8<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:14.85pt'>\r\n  <td width=313 valign=top style='width:234.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=151 valign=top style='width:4.0cm;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=81 valign=top style='width:60.95pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\n  style='font-family:\"Arial\",sans-serif'>Please note change in<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:14.85pt'>\r\n  <td width=313 valign=top style='width:234.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=151 valign=top style='width:4.0cm;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=81 valign=top style='width:60.95pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-family:\"Arial\",sans-serif'>reference\r\n  range and method<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Interpretation:<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='margin-left:36.0pt;text-align:justify;text-indent:\r\n-18.0pt;text-autospace:none'><span lang=EN-US style='font-size:9.0pt;\r\nfont-family:\"Arial\",sans-serif'>1.<span style='font:7.0pt \"Times New Roman\"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\r\n<\/span><\/span><span lang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Is\r\nused for the quantitative detection of autoantibodies of IgA class directed\r\nagainst tissue transglutaminase (tTG) in human serum or plasma<\/span><\/p>\r\n\r\n<p class=MsoNormal style='margin-left:36.0pt;text-align:justify;text-indent:\r\n-18.0pt;text-autospace:none'><span lang=EN-US style='font-size:9.0pt;\r\nfont-family:\"Arial\",sans-serif'>2.<span style='font:7.0pt \"Times New Roman\"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\r\n<\/span><\/span><span lang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>tTG\r\nis a calcium-dependent enzyme widely distributed in body fluids and tissues\r\nespecially the gastrointestinal <\/span><\/p>\r\n\r\n<p class=MsoNormal style='margin-left:18.0pt;text-align:justify;text-autospace:\r\nnone'><span lang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nsubmucosa.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='margin-left:18.0pt;text-align:justify;text-autospace:\r\nnone'><span lang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\ntTG activity is increased in the jejunal mucosa in Celiac disease\/Gluten\r\nsensitive enteropathy, which is a\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/p>\r\n\r\n<p class=MsoNormal style='margin-left:18.0pt;text-align:justify;text-autospace:\r\nnone'><span lang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nchronic condition affecting genetically susceptible individuals.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='margin-left:36.0pt;text-align:justify;text-indent:\r\n-18.0pt;text-autospace:none'><span lang=EN-US style='font-size:9.0pt;\r\nfont-family:\"Arial\",sans-serif'>3.<span style='font:7.0pt \"Times New Roman\"'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\r\n<\/span><\/span><span lang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Untreated\r\nsubjects may be asymptomatic or may suffer from failure to thrive, diarrhoea,\r\ngastrointestinal disorder anaemia, chronic fatigue or psychiatric problems<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0 4.\u00a0\u00a0 <\/span><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>In\r\nconjunction with other tests it aids in the diagnosis of celiac disease.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0 5.\u00a0\u00a0 <\/span><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>IgA\r\ncorrelates with disease activity and is thus of paramount importance for diet\r\nmonitoring. It may also help in\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\ndetection of untreated subclinical cases<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><b><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>ASSOCIATED TESTS\r\n:<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0 1. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Gliadin antibodies (IgG\r\nand IgA)<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0 2. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>Endomysial antibodies<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0 3. <\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Arial\",sans-serif'>HLA-DQ2\/DQ8<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"153.0pt 90.0pt 72.0pt 54.0pt"}}