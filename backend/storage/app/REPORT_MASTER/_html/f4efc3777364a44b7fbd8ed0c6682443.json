5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>0.00\r\n  - 60.0<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.4pt'>\r\n  <td width=336 valign=top style='width:252.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=84 valign=top style='width:63.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=75 valign=top style='width:56.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=270 valign=top style='width:202.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.5pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>COMMENT\r\n:<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Thyroglobulin\r\nantibody (TGAb)\u2014 this antibody targets thyroglobulin, the storage form of\r\nthyroid hormones. Thyroid stimulating hormone receptor antibodies\r\n(TSHRAb)\u2014includes two types of autoantibodies that attach to proteins in the\r\nthyroid to which TSH normally binds (TSH receptors):Thyroid stimulating\r\nimmunoglobulin (TSI) binds to receptors and promotes the production of thyroid\r\nhormones, leading to hyperthyroidism. Thyroid binding inhibitory immunoglobulin\r\n(TBII) blocks TSH from binding to receptors, blocking production of thyroid\r\nhormones and resulting in hypothyroidism.Note: Thyroglobulin antibodies may be\r\ndetected in individuals without clinically significant thyroid disease. They do\r\nnot define the patient\u2019s thyroid functional status.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Clinical Use :<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u2022\r\nConfirm presence of Autoimmune thyroid disease<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>Increased Levels<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u2022\r\nHashimoto thyroiditis <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u2022\r\nGraves disease <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u2022\r\nPostpartum thyroiditis <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u2022\r\nPrimary hypothyroidism due to Hashimoto thyroiditis<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"148.85pt 45.0pt 72.0pt 35.45pt"}}