{"scope":"rt-7d5cdc6c92","css":".rt-7d5cdc6c92 p.MsoNormal, .rt-7d5cdc6c92 li.MsoNormal, .rt-7d5cdc6c92 div.MsoNormal {margin:0cm; font-size:10.0pt; font-family:\"Times New Roman\",serif;}\n.rt-7d5cdc6c92 p.MsoBodyText, .rt-7d5cdc6c92 li.MsoBodyText, .rt-7d5cdc6c92 div.MsoBodyText {margin:0cm; font-size:12.0pt; font-family:\"Courier New\";}\n.rt-7d5cdc6c92 div.WordSection1 {}","html":"<div class=WordSection1>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span style='position:relative;z-index:251657728;left:-52px;\r\ntop:18px;width:994px;height:20px'><img width=795 height=2\r\nsrc=\"data:image\/gif;base64,R0lGODlh4gMCAHcAMSH+GlNvZnR3YXJlOiBNaWNyb3NvZnQgT2ZmaWNlACH5BAEAAAAALAAAAADiAwIAgAAAAAAAAAJGBHKJq83vIpyy0msz3rrz74XgKJbkaaboqrbs68bwLNf0bef4rvf87wsChwaiUYg8KpPMpbMJfUqj1Km1ir1qs9ytNwEoAAA7\"><\/span><b><span lang=EN-US style='font-size:14.0pt;\r\nfont-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><span lang=EN-US\r\nstyle='font-size:14.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><span lang=EN-US\r\nstyle='font-size:14.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><span lang=EN-US\r\nstyle='font-size:14.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><span lang=EN-US\r\nstyle='font-size:14.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><span lang=EN-US\r\nstyle='font-size:14.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><b><span lang=EN-US\r\nstyle='font-size:14.0pt