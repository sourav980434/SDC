p class=MsoNormal><b><span lang=EN-US style='font-size:8.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:9.9pt'>\r\n  <td width=37 valign=top style='width:27.65pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:9.9pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=20 valign=top style='width:14.7pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:9.9pt'>\r\n  <p class=MsoNormal style='margin-left:5.1pt'><span lang=EN-US\r\n  style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=599 valign=top style='width:449.05pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:9.9pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:11.0pt'>**Please confirm by ELISA method**<\/span><\/b><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>OUT SIDE SAMPLE<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"153.0pt 90.0pt 72.0pt 36.0pt"}}