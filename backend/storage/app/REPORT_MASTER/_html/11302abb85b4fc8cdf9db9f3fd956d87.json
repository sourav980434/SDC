4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='text-align:justify'><span lang=EN-US>REF.\u00a0\u00a0\u00a0\u00a0\u00a0 :\r\n  Dr. NASSER IQBAL<\/span><\/p>\r\n  <\/td>\r\n  <td width=240 valign=top style='width:180.0pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal style='text-align:justify'><span lang=EN-US>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 REPORT\r\n  DATE\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 :06\/06\/2009<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>.<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Courier New\"'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 DEPARTMENT OF RADIOLOGY &amp; IMAGING<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Courier New\"'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 RADIOGRAPH OF INTRAVENOUS UROGRAM<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n---------------------------------<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Courier New\"'>CONTROL\u00a0 FILM<\/span><\/b><span lang=EN-US style='font-size:11.0pt;\r\nfont-family:\"Courier New\"'> : Large radiodensity noted overlying left renal\r\nfossa.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>Shows\r\nno obvious radiodensity in renal are\u00a0 \/ paravertebral gutters <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>(overlying\r\nureteric tract) \/ pelvis ( overlying bladder area)<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Courier New\"'>CONTRAST\u00a0 STUDY<\/span><\/b><span lang=EN-US style='font-size:\r\n11.0pt;font-family:\"Courier New\"'>:(Using 350 mgI\/ml Omnipaque 50 cc.)<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>Nephrogram\r\nfilm shows normal renal outline bilaterally. <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>Both\r\nkidneys are normal in size , shape and location .<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>Right\r\nkidney shows normal pelvi-caliceal system with prompt excretion. No obvious\r\nfilling defect \/ hydronephrotic changes noted in right renal pelvis. Right\r\nureter is of smooth outline and normal calibre, showing prompt and adequate\r\ncontrast excretion. <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>Left\r\nkidney shows markedly distended [grade IV] hydronephrotic changes with abovementioned\r\nradiodensity in left renal pelvis\u2014-suggestive of calculus at left\r\npelvi-ureteric junction. Left ureteric excretion is intermittent and markedly\r\ndelayed (after 4 hours)\u2014-suggestive of partial obstruction. Hydronephrotic left\r\npelvi-caliceal system shows progressive increase of contrast density with time.\r\n<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>Urinary\r\nbladder outline is within normal limits. <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>No\r\nobvious filling defect noted within bladder lumen.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>Post\r\nvoid film shows insignificant contrast within bladder lumen.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Courier New\"'>IMPRESSION<\/span><\/b><span lang=EN-US style='font-size:11.0pt;\r\nfont-family:\"Courier New\"'> :\u00a0 INTRAVENOUS UROGRAM SHOWS-<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n* MARKED [GRADE IV] HYDRONEPHROSIS LEFT KIDNEY DUE TO CALCULUS AT <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nLEFT PELVI-URETERIC JUNCTION, CAUSING PARTIAL OBSTRUCTION OF <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nLEFT URETER.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Courier New\"'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoPlainText><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoPlainText><span lang=EN-US style='font-size:11.0pt'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nDR.\u00a0 S.\u00a0 BHATTACHARYA<\/span><\/p>\r\n\r\n<p class=MsoPlainText><span lang=EN-US style='font-size:11.0pt'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nMD [RADIOLOGY]<\/span><\/p>\r\n\r\n<p class=MsoPlainText><span lang=EN-US style='font-size:11.0pt'>Checked\r\nby\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0