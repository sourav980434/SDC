ding:0cm 5.4pt 0cm 5.4pt;\r\n  height:14.35pt'>\r\n  <h4><u><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>REFERENCE\r\n  RANGE<\/span><\/u><\/h4>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.85pt'>\r\n  <td width=251 valign=top style='width:188.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=95 valign=top style='width:71.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=87 valign=top style='width:65.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal style='text-align:justify'><b><span lang=EN-US\r\n  style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-align:justify'><b><span lang=EN-US\r\n  style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>NGSP-DCCT<\/span><\/b><\/p>\r\n  <p class=MsoNormal style='text-align:justify'><b><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0 %<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=258 valign=top style='width:193.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.85pt'>\r\n  <td width=251 valign=top style='width:188.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=95 valign=top style='width:71.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=87 valign=top style='width:65.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal align=center style='margin-left:18.6pt;text-align:center'><span\r\n  lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=258 valign=top style='width:193.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.85pt'>\r\n  <td width=251 valign=top style='width:188.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>Glycosylated Hemoglobin A1c <\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=95 valign=top style='width:71.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><b><span\r\n  lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>8.9<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=87 valign=top style='width:65.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>%<\/span><\/p>\r\n  <\/td>\r\n  <td width=258 valign=top style='width:193.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Normal\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n  <b>:\u00a0 <\/b>&lt;8.0 %<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.6pt'>\r\n  <td width=251 valign=top style='width:188.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.6pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>(HbA1c)<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=95 valign=top style='width:71.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.6pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=87 valign=top style='width:65.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.6pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=258 valign=top style='width:193.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.6pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Good\r\n  control\u00a0\u00a0 <b>:\u00a0 <\/b>8.0-9.0 %<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.85pt'>\r\n  <td width=251 valign=top style='width:188.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>(Ion\r\n  Exchange)<\/span><\/p>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>(Chromatographic-spectrophotometric\r\n  )<\/span><\/p>\r\n  <\/td>\r\n  <td width=95 valign=top style='width:71.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=87 valign=top style='width:65.25pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=258 valign=top style='width:193.5pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.85pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Fair\r\n  control\u00a0\u00a0\u00a0\u00a0 <b>:<\/b>\u00a0 9.0-10.0 %<\/span><\/p>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Poor\r\n  control\u00a0\u00a0\u00a0 <b>:\u00a0 <\/b>&gt;10.0 %<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>N.B:<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><span\r\nlang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>Glycosylated\r\nhemoglobin (GHb) is formed continuously by the adduction of glucose by\r\nco-valent bonding to the amino-terminal of the hemoglobin beta chain\r\nprogressively &amp; irreversibly over a period of time &amp; is stable till the\r\nlife of the RBC. This process is slow, non enzymatic and is dependent on the\r\naverage blood Glucose concentration over a period of the time.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>A single glucose\r\ndetermination reflects the glucose level at the time. GHb on the over hand\r\nreflects the mean glucose level over an extended period of time. Thus GHb\r\nreflects the metabolic control of glucose level over a period of time\r\nunaffected by diet, insulin, other drugs, or excercise on the day of testing.\r\nGHb is now widely recognized as an important test for the diagnosis of Diabetes\r\nmellitus and is reliable indicator of the efficacy of therapy.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>In diabetes\r\nmellitus sugar (glucose) accumulates in blood stream beyond normal level.\r\nMeasurement of blood\/plasma glucose level (in fasting, \u201cAfter Meal\u201d i.e. PP or\r\nRandom condition) reflect acute changes related to immediate past condition of\r\nthe patient which may be affected by factors like duration of fasting or the\r\ntime of intake of food before fasting, dosage of anti diabetic drugs, mental\r\nconditions like stress, anxiety etc. it does not indicate the long-term aspects\r\nof diabetic control.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>Glucose combines\r\nwith haemoglobin (Hb) continuously and nearly irreversibly during life span of\r\nRBC (120 days); thus glycosylated Hb is proportional to mean plasma glucose\r\nlevel during previous 2-3 months. HbA1c, a glycosylated Hb\u00a0 comprising 3% - 6%\r\nof the total Hb in healthy may double or even triple in diabetes mellitus\r\ndepending on the level of hyperglycemia (high blood glucose level), thus\r\ncorrelating with lack of glucose control. Therefore A1c assay are useful means\r\nof evaluation of success of long term diabetic control by monitoring diabetic\r\npatients\u2019 compliance with therapeutic regimen used on long-term blood glucose\r\nlevel control. Added advantage is its ability to predict progression of\r\ndiabetic complications.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>HbA1c value is in\r\nno way concerned with the blood glucose on the day of testing and dietary\r\npreparation of testing is unnecessary.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>*VALUES\r\nRECHECKED<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>DRAWN\r\nSAMPLE FROM OUTSIDE<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>NB:<\/span><\/b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\r\nSuggested Clinical Correlation &amp; repeat examination if necessary<\/span><span\r\nlang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>. <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:8.0pt'>Test Done By: \u2013 <\/span><\/b><span\r\nlang=EN-US style='font-size:8.0pt'>Microlab 300 (MERCK) &amp; CHEM \u2013 7 (ERBA)\r\nAutomated Biochemistry Analyzer<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"595.45pt 841.7pt","margin":"151.2pt 36.0pt 72.0pt 36.0pt"}}