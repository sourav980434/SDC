;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=118 valign=top style='width:88.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=204 valign=top style='width:153.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:12.7pt'>\r\n  <td width=292 valign=top style='width:219.3pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=133 valign=top style='width:100.1pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=118 valign=top style='width:88.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=204 valign=top style='width:153.2pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:12.7pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>Reference\r\nRange:-<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Therapeutic\r\nrange : 10-20<\/span><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\r\n<\/span><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\u00b5g\/mL<\/span><span\r\nlang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Phenytoin\r\nor Eptoin or Dilantin are different names of the same drug.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Therapeutic\r\nSignificance:<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Phenytoin\r\nis the most widely prescribed Anti \u2013 Convulsant drug. Phenytoin is considered\r\nthe drug of choice for generalized major motor (grand mal epilepsy) and focal\r\nseizures. It can also be used to treat elementary partial or complex partial\r\nseizures.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Concentration\r\nabove the therapeutic range of 10 to 20 \u00b5g\/mL<\/span><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'> can result in toxic effects,\r\nwhich include nystagmus, ataxia, drowsiness, tremor, confusion and psychiatric\r\ndisturbances. Routine monitoring of serum phenytoin<\/span><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'> concentrations\r\nis necessary to maintain therapeutic efficacy and avoid toxicity. For\r\ndiagnostic purpose, results should always be assessed in conjunction with the\r\ntime of blood collection, dosage and other medical history, clinical\r\nexamination and related findings.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>Please\r\ncorrelate with clinical conditions.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify;text-autospace:none'><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"595.45pt 841.7pt","margin":"151.2pt 36.0pt 72.0pt 36.0pt"}}