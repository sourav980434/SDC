.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>0.39\r\n  - 6.16 <\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.0pt'>\r\n  <td width=343 valign=top style='width:257.1pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:8.0pt'>(enzyme \u2013linked\r\n  immunosorbent assay )<\/span><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=80 valign=top style='width:60.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.0pt'>\r\n  <td width=343 valign=top style='width:257.1pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=80 valign=top style='width:60.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.0pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:13.75pt'>\r\n  <td width=343 valign=top style='width:257.1pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=104 valign=top style='width:77.8pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=80 valign=top style='width:60.35pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=222 valign=top style='width:166.45pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:13.75pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<\/div>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><u><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>T3:<\/span><\/u><\/b><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'> <\/span><\/b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>The\r\nhuman thyroid gland is a major component of the endocrine system. Thyroid\r\nhormones perform many important functions. They exert powerful and essential\r\nregulatory influences on growth, differentiation, cellular metabolism and\r\ngeneral hormonal balance of the body, as well as on the maintenance of\r\nmetabolic activity and the development of the skeletal and organ system.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>The determination\r\nof T3 levels in serum is essential in assessing thyroid functions. In most\r\nhyperthyroid patients, both serum T3 &amp; T4 are elevated. However a condition\r\nknown as T3 thyrotoxicosis exhibits only elevated T3 concentrations. Serum T3\r\nlevels are also an excellent indicator of the effectiveness of thyroid therapy.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><u><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>TSH:<\/span><\/u><\/b><b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'> <\/span><\/b><span\r\nlang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>The\r\nThyroid Stimulating Hormone (thyrotropin or TSH) is a glycoprotein with a\r\nmolecular weight of 28000, secreted by the adenohypophysis. TSH is controlled\r\nby negative feedback from circulating T3, T4 and TRH (Thyrotropin Releasing\r\nHormone).<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>The measurement\r\nof serum TSH has proven to be one of the most sensitive methods for the\r\ndetection of primary hypothyroidism. In primary hypothyroidism the production\r\nof thyroid hormones is impaired and the TSH levels are observed to be higher.\r\nHowever, is secondary and tertiary hypothyroidism, the TSH levels are low\r\nbecause of pituitary of hypothalamic lesions.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>In hypothyroidism\r\nthe circulating level of TSH is usually subnormal. In some instances, however\r\nthis condition may result from hyperstimulation of the thyroid, due to\r\nhypothalamic or pituitary lesions and in this case the TSH level is increased. <\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>Lipemic\r\nsample. Minor deviations of the results may not be unlikely.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0<\/span><b><span\r\nlang=EN-US style='font-family:\"Bookman Old Style\",serif'>Clinical correlation\r\nis suggested. <\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>Lisa\r\nScan-EM (Semi-Automated Clinical ELISA Analyzer)<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-size:11.0pt;font-family:\r\n\"Bookman Old Style\",serif'>OUT SIDE SAMPLE<\/span><\/b><\/p>\r\n\r\n<\/div>","page":{"size":"595.45pt 841.7pt","margin":"151.2pt 36.0pt 72.0pt 36.0pt"}}