rmal><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=98 valign=top style='width:73.2pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:9.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>MFG. BY<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=21 valign=top style='width:15.9pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:9.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>:<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=508 colspan=2 valign=top style='width:380.9pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>hCG\r\n  PREGNANCY RAPID TEST<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=98 valign=top style='width:73.2pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:9.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=21 valign=top style='width:15.9pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:9.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=508 colspan=2 valign=top style='width:380.9pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr>\r\n  <td width=98 valign=top style='width:73.2pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:9.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>LOT NO.<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=21 valign=top style='width:15.9pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><b><span lang=EN-US style='font-size:9.0pt;font-family:\r\n  \"Bookman Old Style\",serif'>:<\/span><\/b><\/p>\r\n  <\/td>\r\n  <td width=508 colspan=2 valign=top style='width:380.9pt;padding:0cm 5.4pt 0cm 5.4pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:9.0pt;font-family:\"Bookman Old Style\",serif'>HCG20030084<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr height=0>\r\n  <td width=98 style='border:none'><\/td>\r\n  <td width=21 style='border:none'><\/td>\r\n  <td width=129 style='border:none'><\/td>\r\n  <td width=306 style='border:none'><\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<\/div>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:12.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>Note:-<\/span><\/b><span\r\nlang=EN-US style='font-family:\"Bookman Old Style\",serif'> Human chorionic\r\ngonadotropin (hCG) is glycoprotein hormone produced by the developing placenta\r\nshortly after fertilization. In normal pregnancy, hCG can be detected in both\r\nurine and serum as early as 7 to 10 days after conceptions. <\/span><span\r\nlang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>1,2,3,4<\/span><span\r\nlang=EN-US style='font-family:\"Bookman Old Style\",serif'> hCG levels continue\r\nto rice very rapidly frequently exceeding 100 mlu\/mL by the first menstrual\r\nperiod <\/span><span lang=EN-US style='font-size:8.0pt;font-family:\"Bookman Old Style\",serif'>2,3,4<\/span><span\r\nlang=EN-US style='font-family:\"Bookman Old Style\",serif'> and peaking in the\r\n100,000 \u2013 200,000 mlu\/mL range about 10-12 weeks into pregnancy. The appearance\r\nof hCG in both the urine and serum soon after conception, and its subsequent\r\nrapid rise in conception during early gestational growth, make it an excellent\r\nmarker for the early detection of pregnancy.\u00a0 <b>(Choriocarcinoma will also\r\ngive a positive result)<\/b> \u00a0\u00a0\u00a0\u00a0\u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0<\/span><b><span\r\nlang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>OUT\r\nSIDE SAMPLE<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"595.45pt 841.7pt","margin":"151.2pt 36.0pt 72.0pt 36.0pt"}}