t;\r\n  height:18.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>63.9<\/span><\/p>\r\n  <\/td>\r\n  <td width=54 valign=top style='width:40.5pt;border:none;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:18.7pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt'>U\/L<\/span><\/p>\r\n  <\/td>\r\n  <td width=226 valign=top style='width:169.2pt;border:none;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:18.7pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt'>66-114 U\/L<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:19.75pt'>\r\n  <td width=355 valign=top style='width:266.4pt;border:none;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:19.75pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>(Spectrophotometry)<\/span><\/p>\r\n  <\/td>\r\n  <td width=114 valign=top style='width:85.5pt;border:none;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:19.75pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=54 valign=top style='width:40.5pt;border:none;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:19.75pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span lang=EN-US\r\n  style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=226 valign=top style='width:169.2pt;border:none;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:19.75pt'>\r\n  <p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>Comments :<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nAngiotensin converting enzyme (ACE) modulates peripheral vascular resistance as\r\nwell as renal and cardiovascular function.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 It\r\nis responsible for conversion of Angiotensin I to Angiotensin II as well as\r\ninactivation of bradykinin. Majority of ACE is tissue<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nbound (&gt;90%) found predominantly in lungs &amp; testes.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>Factors affecting ACE\r\nlevels :<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n* Smoking -- ACE activity is 30% lower in smokers.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n* Thyroid hormone -- Stimulates ACE synthesis.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n* Postmenopausal estrogen replacement -- ACE activity is 205 lower.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>Increased level :<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nSarcoidosis -- ACE levels are used in the diagnosis and monitoring of this\r\ndisease and are directly related to the number\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nof organs affected and activity of granulomas. Mature granulomas produce less\r\nACE than developing <\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nones. ACE is more likely to be elevated with pulmonary involvement than with\r\npurely hilar adenopathy.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nPulmonary causes like emphysema, Asthma, Small cell carcinoma &amp; Squamous\r\ncell carcinoma.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nRenal diseases -- patients on hemodialysis show high ACE levels as compared to\r\npatients who are not on dialysis.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\nOther causes -- Multiple sclerosis, Addisons disease, hyperthyroidism,\r\nDiabetes, Alcoholic hepatitis &amp; Peptic ulcr.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>Decreased levels :<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n* Chronic liver disease.<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-autospace:none'><span lang=EN-US\r\nstyle='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n* Anorexia nervosa.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:8.0pt;font-family:\"Arial\",sans-serif'>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\r\n* Hypothyroidism.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span lang=EN-US>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>.<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal align=center style='text-align:center'><span\r\nstyle='position:relative;z-index:251657728;left:-54px;top:236px;width:1052px;\r\nheight:238px'><img width=842 height=2 src=\"data:image\/gif;base64,R0lGODlhHAQCAHcAMSH+GlNvZnR3YXJlOiBNaWNyb3NvZnQgT2ZmaWNlACH5BAEAAAAALAAAAAAcBAIAgAAAAAAAAAJXjI+py+0Po5y02ouz3rz7D4biSJbmiabqyrbuC8cUAAT1bef4rvf87wsCh8Ii8WhMIpfKJvPpjEKn0ir1as1it9ou9+sNg8fiMvlsTqPX6jb77Y7Dz4ACADs=\"><\/span><b><span\r\nlang=EN-US style='font-size:14.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<br clear=ALL>\r\n\r\n<h4 align=center style='text-align:center'><u><span lang=EN-US\r\nstyle='font-family:\"Bookman Old Style\",serif'>DEPARTMENT OF PATHOLOGY<\/span><\/u><\/h4>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-size:11.0pt;font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 align=left\r\n width=749 style='width:561.6pt;border-coll