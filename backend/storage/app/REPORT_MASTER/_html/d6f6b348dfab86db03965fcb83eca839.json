t;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal align=center style='text-align:center'><span\r\n  style='font-size:11.0pt;font-family:\"Calibri\",sans-serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=137 valign=top style='width:102.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal align=center style='text-align:center;line-height:115%'><span\r\n  lang=EN-US style='font-size:10.5pt;line-height:115%'>NEGATIVE<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n <tr style='height:16.2pt'>\r\n  <td width=236 valign=top style='width:176.65pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal style='line-height:115%;text-autospace:none'><span\r\n  lang=EN-US style='font-family:\"Bookman Old Style\",serif'>Methodology: PCR<\/span><\/p>\r\n  <\/td>\r\n  <td width=157 valign=top style='width:117.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal style='line-height:115%;text-autospace:none'><span\r\n  style='font-size:8.0pt;line-height:115%;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=132 valign=top style='width:99.0pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal style='line-height:115%;text-autospace:none'><span\r\n  style='font-size:8.0pt;line-height:115%;font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n  <td width=137 valign=top style='width:102.75pt;padding:0cm 5.4pt 0cm 5.4pt;\r\n  height:16.2pt'>\r\n  <p class=MsoNormal style='line-height:115%'><span style='font-family:\"Arial\",sans-serif'>&nbsp;<\/span><\/p>\r\n  <\/td>\r\n <\/tr>\r\n<\/table>\r\n\r\n<p class=MsoNormal><span lang=EN-US>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>COMMENT<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>Human\r\nleukocyte antigen B27 (HLA-B27) is a major histocompatibility complex class 1\r\nmolecule that is strongly associated with the disease ankylosing spondylitis.\r\nTesting for HLA B27 is of diagnostic value because 90% of patients with\r\nankylosing spondylitis have the B27 antigen. The outcome of this test must\r\nalways be correlated with history, clinical significance of the patient and\r\nother pertinent data and should not be used alone for the interpretation of\r\nresult.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><b><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>Please\r\nNote:<\/span><\/b><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>&nbsp;<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>1.The\r\nresults of this report need to be interpreted by a qualified medical\r\nprofessional.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>2.\r\nEach technology has a limitation and hence it is advised to corroborate the\r\nresults with different \u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\r\ntechniques or through repeat sampling if indications persist<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>3.\r\nSame technique\/lab is advisable for follow up testing during treatment<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>4.\r\nAlthough all precautions are taken during molecular genetic tests, the\r\ncurrently available data indicate <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\r\nthat the technical e molecular DNA analysis is approximately 2%. It is\r\nimportant that all clinicians or \u00a0<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\r\npersons requesting Molecular Diagnostic testing are aware of these data before\r\nacting upon the results.<\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>5.\r\nThe results assume that the sample is provided from this patient only and that\r\nall patient information <\/span><\/p>\r\n\r\n<p class=MsoNormal><span lang=EN-US style='font-family:\"Bookman Old Style\",serif'>\u00a0\u00a0\u00a0\r\nprovided is correct.<\/span><\/p>\r\n\r\n<\/div>","page":{"size":"612.0pt 792.0pt","margin":"153.0pt 49.5pt 72.0pt 40.5pt"}}